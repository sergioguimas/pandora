# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local Claude Code config (hooks, agents, permissions — machine-specific)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Dumps de DADOS do Supabase — contêm dados reais (auth.users com e-mails e
# hashes de senha, mensagens das conversas, perfis, embeddings). Nunca versionar.
# Snapshots de SCHEMA (sem dados) podem ser commitados: servem de referência,
# já que as migrations sofreram drift. Ver docs/DIVIDA-TECNICA.md → PD-18.
supabase/schema/*_data_*.sql

# vercel
.vercel

# Documentos internos de negócio (não versionar)
business/

# typescript
*.tsbuildinfo
next-env.d.ts
